    "# Model columns and historical / scenario-phase rows.\n",
    "model_labels = {\n",
    "    \"MIROC\": \"MIROC6\", \"MIROC-ES2L\": \"MIROC-ES2L\",\n",
    "    \"MPI-ESM-LR\": \"MPI-ESM1.2-LR\", \"CanESM5\": \"CanESM5\",\n",
    "}\n",
    "# Retain the original order of scenario/phase combinations.\n",
    "panel_defs = [\n",
    "    (\"ssp119\", \"Hist\", \"Historical\\n1980-2014\"),\n",
    "    (\"ssp119\", \"MidTerm\", \"SSP1-1.9\\nCO$_2$ increasing\\n2015-2049\"),\n",
    "    (\"ssp126\", \"MidTerm\", \"SSP1-2.6\\nCO$_2$ increasing\\n2015-2049\"),\n",
    "    (\"ssp119\", \"LongTerm\", \"SSP1-1.9\\nCO$_2$ decreasing\\n2065-2099\"),\n",
    "    (\"ssp126\", \"LongTerm\", \"SSP1-2.6\\nCO$_2$ decreasing\\n2065-2099\"),\n",
    "]\n",
    "\n",
    "def_levs = np.arange(-5.0, 5.5, 0.5)\n",
    "aru_norm = mcolors.TwoSlopeNorm(vmin=-5.0, vcenter=0.0, vmax=5.0)\n",
    "n_rows, n_cols = len(panel_defs), len(LENS_name)\n",
    "fig = plt.figure(figsize=(16, 20))\n",
    "gs = gridspec.GridSpec(\n",
    "    n_rows, n_cols, figure=fig,\n",
    "    left=0.13, right=0.98, top=0.93, bottom=0.115,\n",
    "    wspace=0.10, hspace=0.13,\n",
    ")\n",
    "axs = np.empty((n_rows, n_cols), dtype=object)\n",
    "for row, (scen, time_frame, row_label) in enumerate(panel_defs):\n",
    "    for col, model in enumerate(LENS_name):\n",
    "        ax = fig.add_subplot(gs[row, col], projection=ccrs.NorthPolarStereo())\n",
    "        axs[row, col] = ax\n",
    "        beta = combined.sel(model=model, scenario=scen, time_frame=time_frame).squeeze(drop=True)\n",
    "        if \"time\" in beta.dims:\n",
    "            beta = beta.isel(time=0, drop=True)\n",
    "        beta = beta.transpose(\"lat\", \"lon\")\n",
    "        data_cyclic, lon_cyclic = cutil.add_cyclic_point(\n",
    "            beta.values, coord=beta[\"lon\"].values, axis=-1\n",
    "        )\n",
    "        cf = plot_data_polar(\n",
    "            data_cyclic, beta[\"lat\"].values, lon_cyclic,\n",
    "            ax=ax, levels=def_levs, norm=aru_norm, cmap=cmap_beta,\n",
    "            extend=\"both\", show_xticks=True, show_yticks=True,\n",
    "            label_longitude=False, min_lat=66.5,\n",
    "            # Hatching remains disabled, as in the original display cell.\n",
    "        )\n",
    "        ax.add_feature(cfeature.LAND, facecolor=\"lightgrey\", edgecolor=\"none\", zorder=3)\n",
    "        if row == 0:\n",
    "            # Requested display count for MIROC-ES2L; data selection is unchanged.\n",
    "            n_members = (10 if model == \"MIROC-ES2L\"\n",
    "                         else beta_ds_Future_midTerm[model].sizes[\"member\"])\n",
    "            ax.set_title(\n",
    "                f\"{model_labels[model]}\\n({n_members})\",\n",
    "                fontsize=TITLE_FONTSIZE, pad=14,\n",
    "            )\n",
    "        if col == 0:\n",
    "            ax.text(\n",
    "                -0.20, 0.5, row_label, transform=ax.transAxes,\n",
    "                rotation=90, ha=\"center\", va=\"center\",\n",
    "                fontsize=ROW_LABEL_FONTSIZE,\n",
    "            )\n",
    "        ax.text(\n",
    "            -0.05, 1.02, chr(97 + row * n_cols + col),\n",
    "            transform=ax.transAxes, fontsize=PANEL_LABEL_FONTSIZE,\n",
    "            fontweight=\"bold\", ha=\"center\", va=\"center\",\n",
    "        )\n",
    "\n",
    "# Shared horizontal colorbar, styled like Figure 2; retain the scaling range.\n",
    "cbar_ax = fig.add_axes([0.24, 0.085, 0.60, 0.012])\n",
    "cbar = fig.colorbar(cf, cax=cbar_ax, orientation=\"horizontal\", extend=\"both\")\n",
    "tick_locs = np.arange(-5.0, 5.1, 1.0)\n",
    "cbar.set_ticks(tick_locs)\n",
    "cbar.ax.set_xticklabels([f\"{x:.1f}\" for x in tick_locs], fontsize=COLORBAR_TICK_FONTSIZE)\n",
    "cbar.ax.tick_params(\n",
