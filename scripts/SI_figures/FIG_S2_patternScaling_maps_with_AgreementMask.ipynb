   "source": [
    "# Check the realization's agreement within the ensemble size for each model and scenario: 66% agreement threshold\n",
    "agreement_threshold = 0.66\n",
    "# define the subfunction to check agreement across realizations for a given model and scenario\n",
    "def check_agreement(ds, agreement_threshold=0.66):\n",
    "    # Count the number of realizations (members)\n",
    "    num_members = ds.sizes['member']\n",
    "\n",
    "    # Count how many members agree on the sign of the pattern at each grid point\n",
    "    sign_agreement = (ds > 0).sum(dim='member') / num_members\n",
    "\n",
    "    # Create a mask where agreement exceeds the threshold\n",
    "    agreement_mask = sign_agreement >= agreement_threshold\n",
    "\n",
    "    return agreement_mask"
   ]
  },
