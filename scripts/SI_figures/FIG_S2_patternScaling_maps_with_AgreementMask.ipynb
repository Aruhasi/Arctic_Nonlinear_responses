    "plt.savefig(f\"{data_fig_out}/Extended_Data_Fig2_fingerprint_LEs_polar(Hist&MT&LT).pdf\", dpi=300, bbox_inches=\"tight\")\n",
    "plt.savefig(f\"{data_fig_out}/Extended_Data_Fig2_fingerprint_LEs_polar(Hist&MT&LT).png\", dpi=300, bbox_inches=\"tight\")\n",
